{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "buildCommand": "corepack enable && pnpm install --frozen-lockfile && pnpm turbo run build --filter=@avitus/api..."
  },
  "deploy": {
    "preDeployCommand": [
      "pnpm db:migrate",
      "pnpm db:bootstrap:prod"
    ],
    "startCommand": "pnpm --filter @avitus/api start",
    "healthcheckPath": "/ready",
    "healthcheckTimeout": 100
  }
}
