# syntax=docker/dockerfile:1.7
FROM node:22-bookworm-slim

WORKDIR /app
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH

RUN corepack enable

COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm turbo run build --filter=@avitus/api...

ENV NODE_ENV=production
EXPOSE 4000

CMD ["pnpm", "--filter", "@avitus/api", "start"]
